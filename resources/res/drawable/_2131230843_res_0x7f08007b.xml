<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item state_pressed="true">
        <shape shape="0">
            <solid color="#f2f3f5"/>
            <stroke
                width="1dp"
                color="#bcc0c4"/>
            <corners radius="24dp"/>
        </shape>
    </item>
    <item>
        <shape shape="0">
            <solid color="@android:color/transparent"/>
            <stroke
                width="1dp"
                color="#ccd0d5"/>
            <corners radius="24dp"/>
        </shape>
    </item>
</selector>
